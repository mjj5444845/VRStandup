# Local CLI deployment exclusions. Git-based builds have a different source flow.
# See docs/guides/SETUP.md. Never place private files in public/.

# Historical material and local-only source assets.
archive/
local_assets/
raw/
recordings/
standup_video/
videoshortcutpic/
backups/

# Research data, machine certificates, and actual participant allocation.
data/
certs/
study/config/allocation.json
.env*
*.pem
*.key
*.p12
*.pfx

# Source imports must remain available to the Next.js build.
# Laboratory processes are not launched by the Vercel deployment.
spikes/
tools/

# Local installations, generated results, and development caches.
node_modules/
.next/
.next-pages/
.vinext/
.wrangler/
dist/
out/
output/
outputs/
coverage/
work/
*.tsbuildinfo
*.log
.DS_Store

# Tracked project notes contain the task catalog imported by the build.
README.md
AGENTS.md
CLAUDE.md
punchcap-recording-check-*.json

punchcap-take-*.json
punchcap-session-*.json
