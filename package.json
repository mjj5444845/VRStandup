{
  "name": "vr-standup",
  "version": "0.1.0",
  "private": true,
  "description": "An immersive stand-up comedy experience built with A-Frame.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:mixamo": "node tools/mixamo/validate_aframe_runtime.mjs public/avatars/new_avatar_mixamo/output/Ch02_nonPBR_avatar.glb --required IDLE_Idle PERFORM_Talking1 PERFORM_Waving SIT_Sitting1"
  },
  "dependencies": {
    "aframe": "1.8.0",
    "aframe-extras": "7.7.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three-bmfont-text": "3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "aframe": {
      "three-bmfont-text": "3.0.0"
    }
  },
  "type": "module"
}
