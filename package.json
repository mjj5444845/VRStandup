{
  "name": "punchcap",
  "version": "0.1.0",
  "private": true,
  "description": "PunchCap WebXR research system.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:boundaries && npm run test:architecture && npm run test:deployment && npm run test:spike && npm run test:dashboard && npm run test:core && npm run test:formal",
    "test:deployment": "node --import tsx --test scripts/deployment.test.ts",
    "test:spike": "node --import tsx --test study/spikes/https-config.test.ts study/spikes/network-protocol.test.ts study/spikes/network-hub.test.ts study/spikes/media-check-rules.test.ts study/spikes/media-fixture.test.ts study/spikes/chroma-key-rules.test.ts study/spikes/replay-rules.test.ts study/spikes/recording-rules.test.ts study/spikes/recording-capture.test.ts",
    "spike:cert": "node --import tsx study/spikes/prepare-cert.ts",
    "spike:https": "node --import tsx study/spikes/https-server.ts",
    "spike:net": "node --import tsx study/spikes/https-server.ts --http --port 3001",
    "spike:media-fixture": "node --import tsx study/spikes/generate-media-fixture.ts",
    "spike:chroma-fixture": "node --import tsx study/spikes/generate-chroma-fixture.ts",
    "test:dashboard": "node --import tsx --test app/dashboard/task-model.test.ts",
    "check:boundaries": "node --import tsx scripts/architecture/run.ts",
    "test:architecture": "node --import tsx --test scripts/architecture/check-boundaries.test.ts",
    "test:core": "node scripts/run-tests.mjs core --coverage",
    "test:web": "node --import tsx --test study/web/browser-check.test.ts",
    "test:formal": "node scripts/run-tests.mjs formal",
    "assets:prepare": "node --import tsx study/tools/assets-cli.ts prepare",
    "assets:verify": "node --import tsx study/tools/assets-cli.ts verify",
    "assets:rehearsal": "node --import tsx study/tools/assets-cli.ts rehearsal",
    "lab:start": "node --import tsx study/server/cli.ts",
    "lab:dev": "node --import tsx study/server/cli.ts --dev",
    "assets:sync": "node --import tsx study/tools/assets-cli.ts sync"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
