{
  "name": "punchcap",
  "version": "0.1.0",
  "private": true,
  "description": "PunchCap WebXR research system.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:spike",
    "test:spike": "node --import tsx --test study/spikes/https-config.test.ts study/spikes/network-protocol.test.ts study/spikes/network-hub.test.ts study/spikes/media-check-rules.test.ts study/spikes/media-fixture.test.ts",
    "spike:cert": "node --import tsx study/spikes/prepare-cert.ts",
    "spike:https": "node --import tsx study/spikes/https-server.ts",
    "spike:net": "node --import tsx study/spikes/https-server.ts --http --port 3001",
    "spike:media-fixture": "node --import tsx study/spikes/generate-media-fixture.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
